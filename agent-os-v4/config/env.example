# ── Agent-OS core ─────────────────────────────────────────────────────────
AGENT_OS_ENV=development
AGENT_OS_DATA_DIR=./data
AGENT_OS_REPO_ROOT=~/src/yokk
RUST_LOG=info

# ── Dev tool binaries ─────────────────────────────────────────────────────
CODEX_BIN=codex
CLAUDE_CODE_BIN=claude

# ── Safety limits ─────────────────────────────────────────────────────────
AGENT_OS_ALLOW_AUTO_COMMIT=false
AGENT_OS_ALLOW_AUTO_PR=false
AGENT_OS_MAX_CHANGED_FILES=25
AGENT_OS_DEV_TIMEOUT_SECS=1800

# ── LLM Router — Bo AI tier cascade ──────────────────────────────────────
# Tier 1: Local llama.cpp (offline-first, no key needed)
LOCAL_LLM_URL=http://127.0.0.1:8080/v1
LOCAL_LLM_MODEL=smollm2-360m-q4

# Tier 2+3: SiliconFlow (Liquid LFM2 = cheap, Qwen 72B = balanced)
SILICONFLOW_API_KEY=replace-me
SILICONFLOW_CHEAP_MODEL=liquid/lfm2-1.2b
SILICONFLOW_BALANCED_MODEL=qwen/qwen2.5-72b-instruct

# Tier 4: Anthropic Claude (premium / moderation)
ANTHROPIC_API_KEY=replace-me
ANTHROPIC_MODEL=claude-sonnet-4-6

# Tier 5: HuggingFace (fallback)
HF_API_KEY=replace-me
HF_MODEL=mistralai/Mistral-7B-Instruct-v0.2

# Legacy OPENAI_* vars still work if none of the above are set
OPENAI_BASE_URL=http://127.0.0.1:8402/v1
OPENAI_API_KEY=replace-me
OPENAI_MODEL=blockrun/auto

# ── Integrations ──────────────────────────────────────────────────────────
# Slack webhook for slack-digest plugin
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/replace-me

# GitHub — used by github-sync plugin (gh CLI must be authenticated separately)
# GITHUB_TOKEN is read by gh CLI automatically if set
GITHUB_TOKEN=replace-me
